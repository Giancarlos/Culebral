{
  "$schema": "http://json.schemastore.org/template",
  "author": "Culebral Contributors",
  "classifications": [ "Common", "Library", "Culebral" ],
  "identity": "Culebral.Templates.ClassLib",
  "name": "Culebral Class Library",
  "shortName": "culebral-classlib",
  "tags": {
    "language": "Culebral",
    "type": "project"
  },
  "sourceName": "CuleralClassLib",
  "preferNameDirectory": true,
  "symbols": {
    "framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10"
        },
        {
          "choice": "net9.0",
          "description": "Target .NET 9"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
