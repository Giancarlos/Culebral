# Collections — lists, dicts, sets, comprehensions, and built-in functions.

def main():
    # ─── Lists ───
    numbers = [3, 1, 4, 1, 5, 9, 2, 6]
    print(f"numbers: length = {len(numbers)}")
    print(f"first = {numbers[0]}, last = {numbers[-1]}")  # negative indexing

    # ─── List comprehensions ───
    squares = [x * x for x in range(6)]
    print("squares:", squares)

    evens = [x for x in numbers if x % 2 == 0]
    print("evens:", evens)

    # ─── Dicts ───
    scores = {"alice": 95, "bob": 87, "carol": 92}
    print(f"scores: {len(scores)} entries")

    # Dict comprehension
    doubled = {x: x * 2 for x in range(5)}
    print("doubled:", doubled)

    # ─── Sets (duplicate removal) ───
    unique = {3, 1, 4, 1, 5, 9, 2, 6, 5, 3}
    print(f"unique values: {len(unique)}")

    # ─── Built-in collection functions ───
    items = [5, 2, 8, 1, 9, 3]
    print(f"sorted: {sorted(items)}")
    print(f"reversed: {reversed(items)}")
    print(f"min = {min(items)}, max = {max(items)}, sum = {sum(items)}")
    print(f"all positive: {all([True, True, True])}")
    print(f"any zero: {any([False, False, True])}")

    # ─── Slicing ───
    data = [10, 20, 30, 40, 50]
    print(f"data[1:3] = {data[1:3]}")      # [20, 30]

    # ─── Tuple unpacking ───
    a, b = 1, 2
    print(f"a = {a}, b = {b}")
    a, b = b, a                     # swap
    print(f"swapped: a = {a}, b = {b}")
