# Control flow — if/elif/else, while loops, for loops, break/continue.

def classify(n: int) -> str:
    if n > 0:
        return "positive"
    elif n < 0:
        return "negative"
    else:
        return "zero"

def main():
    # if/elif/else
    print(classify(42))     # "positive"
    print(classify(-7))     # "negative"
    print(classify(0))      # "zero"

    # for loop with range
    total = 0
    for i in range(1, 11):
        total += i
    print(f"Sum 1..10 = {total}")   # 55

    # while loop with break
    x = 1
    while True:
        if x > 5:
            break
        print(x, end=" ")
        x += 1
    print()  # newline

    # for-else: else runs only if loop completes without break
    for item in range(10):
        if item == 99:
            break
    else:
        print("No break — else block runs")
