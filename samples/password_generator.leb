# Password Generator — create random passwords with configurable rules.
#
# Uses .NET's System.Random and string operations.
#
# Run with: culebral run samples/password_generator.leb

from System import Random

def generate_password(length: int, use_upper: bool, use_digits: bool, use_symbols: bool) -> str:
    chars = "abcdefghijklmnopqrstuvwxyz"
    if use_upper:
        chars = chars + "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    if use_digits:
        chars = chars + "0123456789"
    if use_symbols:
        chars = chars + "!@#$%^&*()-_=+"

    rng = Random()
    password = ""
    i = 0
    while i < length:
        idx = rng.next(0, len(chars))
        password = password + chars[idx:idx + 1]
        i += 1

    return password

def main():
    print("=== Password Generator ===")
    print()

    # Simple lowercase
    print(f"Simple (8):  {generate_password(8, False, False, False)}")

    # With uppercase
    print(f"Upper (12):  {generate_password(12, True, False, False)}")

    # Full strength
    print(f"Strong (16): {generate_password(16, True, True, True)}")
    print(f"Strong (20): {generate_password(20, True, True, True)}")
    print(f"Strong (24): {generate_password(24, True, True, True)}")
