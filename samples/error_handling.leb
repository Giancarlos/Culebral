# Error handling — try/except/finally, raise, assert, and the Result type.
#
# Culebral has both exceptions (for truly exceptional cases) and
# the built-in Result type (for expected failures like parsing, lookups).

# ─── Result type (built-in, no import needed) ───

def divide(a: int, b: int) -> Result:
    if b == 0:
        return Err("division by zero")
    return Ok(a // b)

# ─── Exceptions ───

def risky_operation(x: int) -> int:
    if x < 0:
        raise Exception(f"negative input: {x}")
    return x * 2

def main():
    # ─── Result type ───
    r1 = divide(10, 3)
    print(f"10 / 3 = {r1.value}, ok = {r1.is_ok}")   # 3, True

    r2 = divide(10, 0)
    print(f"error: {r2.value}, ok = {r2.is_ok}")       # division by zero, False

    # ─── Try/except/finally ───
    try:
        result = risky_operation(-5)
        print(result)
    except Exception as e:
        print(f"Caught: {e}")
    finally:
        print("Cleanup runs always")

    # ─── Assert (stripped in release builds) ───
    assert 2 + 2 == 4
    assert len("hello") == 5
    print("All assertions passed")
