# ASP.NET Web API — a web server written in Culebral.
#
# Python-like syntax running on ASP.NET's Kestrel web server.
# Returns "Hello from Culebral on ASP.NET!" on GET /
#
# Run from this directory:
#   cd samples/web-api
#   dotnet run --project ../../src/Culebral.Compiler -- run main.leb
#
# Then: curl http://localhost:5000/

from Microsoft.AspNetCore.Builder import WebApplication, EndpointRouteBuilderExtensions
from Microsoft.AspNetCore.Http import RequestDelegateFactory
from Microsoft.Extensions.Hosting import HostingAbstractionsHostExtensions

def main():
    builder = WebApplication.create_builder()
    app = builder.build()

    # Create the handler as a lambda, then wrap it into a RequestDelegate
    # using ASP.NET's RequestDelegateFactory (handles return type serialization)
    handler = lambda: "Hello from Culebral on ASP.NET!"
    rdf = RequestDelegateFactory.create(handler, None)
    EndpointRouteBuilderExtensions.map_get(app, "/", rdf.request_delegate)

    print("Culebral on ASP.NET!")
    print("Listening on http://localhost:5000")
    print("Try: curl http://localhost:5000/")

    app.urls.add("http://localhost:5000")
    HostingAbstractionsHostExtensions.run(app)
