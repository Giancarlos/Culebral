<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>skelvon</AssemblyName>
    <RootNamespace>Skelvon.Compiler</RootNamespace>

    <!-- .NET Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skelvon</ToolCommandName>
    <PackageId>Skelvon.Compiler</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Giancarlos Toro</Authors>
    <Description>The Skelvon programming language compiler — Python's readability, Rust's discipline, .NET's power.</Description>
    <PackageProjectUrl>https://github.com/Giancarlos/Skelvon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Giancarlos/Skelvon</RepositoryUrl>
  </PropertyGroup>

</Project>
